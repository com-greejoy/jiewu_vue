<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.jiewu.mapper.JwMatchMapper">

    <resultMap type="JwMatch" id="JwMatchResult">
        <result property="id" column="id"/>
        <result property="matchName" column="match_name"/>
        <result property="beginTime" column="begin_time"/>
        <result property="endTime" column="end_time"/>
        <result property="signBeginTime" column="sign_begin_time"/>
        <result property="signEndTime" column="sign_end_time"/>
        <result property="addr" column="addr"/>
        <result property="posterImg" column="poster_img"/>
        <result property="state" column="state"/>
        <result property="matchDetails" column="match_details"/>
        <result property="matchRegulations" column="match_regulations"/>
        <result property="sealUnit" column="seal_unit"/>
        <result property="isShow" column="is_show"/>
        <result property="mainImg" column="main_img"/>
        <result property="battleImg" column="battle_img"/>
        <result property="startBackNum"    column="start_back_num"    />
        <result property="invitationCode"    column="Invitation_code"    />
        <result property="invitationList"    column="Invitation_list"    />
        <result property="isShowGrade"    column="is_show_grade"    />
        <result property="manageCode"    column="manage_code"    />
        <result property="matchConfig"    column="match_config"    />
        <result property="lastBackNum"    column="last_back_num"    />

    </resultMap>

    <sql id="selectJwMatchVo">
        select id, match_name, match_config, begin_time, last_back_num, end_time, start_back_num, is_show, main_img, battle_img, seal_unit,
        sign_begin_time, sign_end_time, addr, poster_img, state, match_details, match_regulations, manage_code, Invitation_code, Invitation_list from jw_match
    </sql>

    <!--获取没开始的比赛和正在报名的比赛-->
    <select id="selectFutureIngList" parameterType="JwMatch" resultMap="JwMatchResult">
        <include refid="selectJwMatchVo"/>
        where state = 1 or state = 2
    </select>

    <select id="listWxUserMatchList" parameterType="Long" resultMap="JwMatchResult">
        select jm.* from jw_match_user jmu
        left join jw_match jm on jm.id = jmu.match_id
        where jmu.user_id = #{userId}
    </select>

    <select id="selectJwMatchList" parameterType="JwMatch" resultMap="JwMatchResult">
        <include refid="selectJwMatchVo"/>
        <where>
            <if test="matchName != null  and matchName != ''">and match_name like concat('%', #{matchName}, '%')</if>
            <if test="beginTime != null ">and begin_time = #{beginTime}</if>
            <if test="endTime != null ">and end_time = #{endTime}</if>
            <if test="signBeginTime != null ">and sign_begin_time = #{signBeginTime}</if>
            <if test="signEndTime != null ">and sign_end_time = #{signEndTime}</if>
            <if test="addr != null  and addr != ''">and addr = #{addr}</if>
            <if test="posterImg != null  and posterImg != ''">and poster_img = #{posterImg}</if>
            <if test="state != null  and state != ''">and state = #{state}</if>
            <if test="isShow != null  and isShow != ''">and is_show = #{isShow}</if>
            <if test="isShowGrade != null  and isShowGrade != ''"> and is_show_grade = #{isShowGrade}</if>
            <if test="invitationCode != null  and invitationCode != ''"> and Invitation_code = #{invitationCode}</if>
            <if test="invitationList != null  and invitationList != ''"> and Invitation_list = #{invitationList}</if>
        </where>
    </select>

    <select id="selectJwMatchById" parameterType="Long" resultMap="JwMatchResult">
        <include refid="selectJwMatchVo"/>
        where id = #{id}
    </select>

    <insert id="insertJwMatch" parameterType="JwMatch" useGeneratedKeys="true" keyProperty="id">
        insert into jw_match
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="matchName != null">match_name,</if>
            <if test="beginTime != null">begin_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="signBeginTime != null">sign_begin_time,</if>
            <if test="signEndTime != null">sign_end_time,</if>
            <if test="addr != null">addr,</if>
            <if test="posterImg != null">poster_img,</if>
            <if test="state != null">state,</if>
            <if test="matchDetails != null">match_details,</if>
            <if test="matchRegulations != null">match_regulations,</if>
            <if test="sealUnit != null">seal_unit,</if>
            <if test="isShow != null">is_show,</if>
            <if test="mainImg != null">main_img,</if>
            <if test="battleImg != null">battle_img,</if>
            <if test="startBackNum != null">start_back_num,</if>
            <if test="invitationCode != null">Invitation_code,</if>
            <if test="invitationList != null">Invitation_list,</if>
            <if test="isShowGrade != null">is_show_grade,</if>
            <if test="manageCode != null">manage_code,</if>
            <if test="matchConfig != null">match_config,</if>
            <if test="lastBackNum != null">last_back_num,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="matchName != null">#{matchName},</if>
            <if test="beginTime != null">#{beginTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="signBeginTime != null">#{signBeginTime},</if>
            <if test="signEndTime != null">#{signEndTime},</if>
            <if test="addr != null">#{addr},</if>
            <if test="posterImg != null">#{posterImg},</if>
            <if test="state != null">#{state},</if>
            <if test="matchDetails != null">#{matchDetails},</if>
            <if test="matchRegulations != null">#{matchRegulations},</if>
            <if test="sealUnit != null">#{sealUnit},</if>
            <if test="isShow != null">#{isShow},</if>
            <if test="mainImg != null">#{mainImg},</if>
            <if test="battleImg != null">#{battleImg},</if>
            <if test="startBackNum != null">#{startBackNum},</if>
            <if test="invitationCode != null">#{invitationCode},</if>
            <if test="invitationList != null">#{invitationList},</if>
            <if test="isShowGrade != null">#{isShowGrade},</if>
            <if test="manageCode != null">#{manageCode},</if>
            <if test="matchConfig != null">#{matchConfig},</if>
            <if test="lastBackNum != null">#{lastBackNum},</if>
        </trim>
    </insert>

    <update id="updateJwMatch" parameterType="JwMatch">
        update jw_match
        <trim prefix="SET" suffixOverrides=",">
            <if test="matchName != null">match_name = #{matchName},</if>
            <if test="beginTime != null">begin_time = #{beginTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="signBeginTime != null">sign_begin_time = #{signBeginTime},</if>
            <if test="signEndTime != null">sign_end_time = #{signEndTime},</if>
            <if test="addr != null">addr = #{addr},</if>
            <if test="posterImg != null">poster_img = #{posterImg},</if>
            <if test="state != null">state = #{state},</if>
            <if test="matchDetails != null">match_details = #{matchDetails},</if>
            <if test="matchRegulations != null">match_regulations = #{matchRegulations},</if>
            <if test="sealUnit != null">seal_unit = #{sealUnit},</if>
            <if test="isShow != null and isShow != ''">is_show = #{isShow},</if>
            <if test="mainImg != null and mainImg != ''">main_img = #{mainImg},</if>
            <if test="battleImg != null and battleImg != ''">battle_img = #{battleImg},</if>
            <if test="startBackNum != null">start_back_num = #{startBackNum},</if>
            <if test="invitationCode != null">Invitation_code = #{invitationCode},</if>
            <if test="invitationList != null">Invitation_list = #{invitationList},</if>
            <if test="isShowGrade != null">is_show_grade = #{isShowGrade},</if>
            <if test="manageCode != null">manage_code = #{manageCode},</if>
            <if test="matchConfig != null">match_config = #{matchConfig},</if>
            <if test="lastBackNum != null">last_back_num = #{lastBackNum},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="updateJwMatchInvitationList">
        update jw_match
        set Invitation_list = #{invitationList}
        where id = #{matchId}
    </update>

    <update id="updateJwMatchLastBackNum">
        update jw_match
        set last_back_num = #{lastBackNum}
        where id = #{matchId}
    </update>

    <delete id="deleteJwMatchById" parameterType="Long">
        -- 删决赛成绩
        delete from jw_eight_score where match_id = #{id};
        delete from jw_eight where match_id = #{id};
        -- 删海选成绩
        delete from jw_hai_score where match_id = #{id};
        -- 删赛程
        delete from jw_schedule_info where match_id = #{id};
        delete from jw_schedule_item where match_id = #{id};
        delete from jw_schedule_place where match_id = #{id};
        -- 删裁判关联
        delete from jw_judge_match where match_id = #{id};
        -- 删报名记录
        delete from jw_sign_record_sport where match_id = #{id};
        delete from jw_sign_record where match_id = #{id};
        -- 删报名队伍关联
        delete from jw_match_team where match_id = #{id};
        delete from jw_match_user where match_id = #{id};
        -- 删比赛项目
        delete from jw_game_item where match_id = #{id};
        -- 删比赛
        delete from jw_match where id = #{id};
    </delete>

    <delete id="deleteJwMatchByIds" parameterType="String">
        delete from jw_match where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
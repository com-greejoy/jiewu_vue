<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.jiewu.mapper.JwMatchUserMapper">
    
    <resultMap type="JwMatchUser" id="JwMatchUserResult">
        <result property="userId"    column="user_id"    />
        <result property="matchId"    column="match_id"    />
    </resultMap>

    <sql id="selectJwMatchUserVo">
        select user_id, match_id from jw_match_user
    </sql>

    <select id="selectJwMatchUserList" parameterType="JwMatchUser" resultMap="JwMatchUserResult">
        <include refid="selectJwMatchUserVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="matchId != null "> and match_id = #{matchId}</if>
        </where>
    </select>
    
    <select id="selectJwMatchUserByUserId" parameterType="Long" resultMap="JwMatchUserResult">
        <include refid="selectJwMatchUserVo"/>
        where user_id = #{userId}
    </select>
        
    <insert id="insertJwMatchUser" parameterType="JwMatchUser">
        insert into jw_match_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="matchId != null">match_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="matchId != null">#{matchId},</if>
         </trim>
    </insert>

    <update id="updateJwMatchUser" parameterType="JwMatchUser">
        update jw_match_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="matchId != null">match_id = #{matchId},</if>
        </trim>
        where user_id = #{userId}
    </update>

    <delete id="deleteJwMatchUserByUserId" parameterType="Long">
        delete from jw_match_user where user_id = #{userId}
    </delete>

    <delete id="deleteJwMatchUserByMatchId" parameterType="Long">
        delete from jw_match_user where match_id = #{matchId}
    </delete>

    <delete id="deleteJwMatchUserByUserIds" parameterType="String">
        delete from jw_match_user where user_id in 
        <foreach item="userId" collection="array" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>
</mapper>
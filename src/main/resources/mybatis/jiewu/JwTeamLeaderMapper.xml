<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.jiewu.mapper.JwTeamLeaderMapper">

    <resultMap type="JwTeamLeader" id="JwTeamLeaderResult">
        <result property="id" column="id"/>
        <result property="leaderName" column="leader_name"/>
        <result property="idCard" column="id_card"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="leaderPhone" column="leader_phone"/>
        <result property="createAddId" column="create_add_id"/>
        <result property="userType" column="user_type"/>
        <result property="matchId" column="match_id"/>
    </resultMap>

    <sql id="selectJwTeamLeaderVo">
        select id, leader_name, id_card, create_user_id, leader_phone, create_add_id, user_type, match_id from jw_team_leader
    </sql>

    <select id="selectJwTeamLeaderList" parameterType="JwTeamLeader" resultMap="JwTeamLeaderResult">
        <include refid="selectJwTeamLeaderVo"/>
        <where>
            <if test="leaderName != null  and leaderName != ''">and leader_name like concat('%', #{leaderName}, '%')</if>
            <if test="createUserId != null ">and create_user_id = #{createUserId}</if>
            <if test="leaderPhone != null  and leaderPhone != ''">and leader_phone = #{leaderPhone}</if>
            <if test="createAddId != null ">and create_add_id = #{createAddId}</if>
            <if test="userType != null  and userType != ''">and user_type = #{userType}</if>
            <if test="matchId != null ">and match_id = #{matchId}</if>
        </where>
    </select>

    <select id="selectJwTeamLeaderListByNamePhone" parameterType="JwTeamLeader" resultMap="JwTeamLeaderResult">
        <include refid="selectJwTeamLeaderVo"/>
        <where>
            <if test="id != null">and id != #{id}</if>
            <if test="leaderName != null  and leaderName != ''">and leader_name = #{leaderName}</if>
            <if test="createUserId != null ">and create_user_id = #{createUserId}</if>
            <if test="userType != null  and userType != ''">and user_type = #{userType}</if>
            <if test="matchId != null ">and match_id = #{matchId}</if>
        </where>
    </select>

    <select id="selectJwTeamLeaderById" parameterType="Long" resultMap="JwTeamLeaderResult">
        <include refid="selectJwTeamLeaderVo"/>
        where id = #{id}
    </select>

    <select id="selectJwTeamLeaderListByWxUser" resultMap="JwTeamLeaderResult">
        <include refid="selectJwTeamLeaderVo"/>
        where create_user_id = #{createUserId} and match_id = #{matchId}
        <if test="searchName != null  and searchName != ''">and leader_name like concat('%', #{searchName}, '%')</if>
        order by user_type asc
    </select>

    <insert id="insertJwTeamLeader" parameterType="JwTeamLeader" useGeneratedKeys="true" keyProperty="id">
        insert into jw_team_leader
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="leaderName != null and leaderName != ''">leader_name,</if>
            <if test="idCard != null">id_card,</if>
            <if test="createUserId != null">create_user_id,</if>
            <if test="leaderPhone != null">leader_phone,</if>
            <if test="createAddId != null">create_add_id,</if>
            <if test="userType != null">user_type,</if>
            <if test="matchId != null">match_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="leaderName != null and leaderName != ''">#{leaderName},</if>
            <if test="idCard != null">#{idCard},</if>
            <if test="createUserId != null">#{createUserId},</if>
            <if test="leaderPhone != null">#{leaderPhone},</if>
            <if test="createAddId != null">#{createAddId},</if>
            <if test="userType != null">#{userType},</if>
            <if test="matchId != null">#{matchId},</if>
        </trim>
    </insert>

    <update id="updateJwTeamLeader" parameterType="JwTeamLeader">
        update jw_team_leader
        <trim prefix="SET" suffixOverrides=",">
            <if test="leaderName != null and leaderName != ''">leader_name = #{leaderName},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="createUserId != null">create_user_id = #{createUserId},</if>
            <if test="leaderPhone != null">leader_phone = #{leaderPhone},</if>
            <if test="createAddId != null">create_add_id = #{createAddId},</if>
            <if test="userType != null">user_type = #{userType},</if>
            <if test="matchId != null">match_id = #{matchId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteJwTeamLeaderById" parameterType="Long">
        delete from jw_team_leader where id = #{id}
    </delete>

    <delete id="deleteJwTeamLeaderByIds" parameterType="String">
        delete from jw_team_leader where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.jiewu.mapper.JwTeamMapper">
    
    <resultMap type="JwTeam" id="JwTeamResult">
        <result property="id"    column="id"    />
        <result property="teamName"    column="team_name"    />
        <result property="userName"    column="user_name"    />
        <result property="userPhone"    column="user_phone"    />
        <result property="addr"    column="addr"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="createUserId"    column="create_user_id"    />
        <result property="matchId"    column="match_id"    />
        <result property="indexOrder"    column="index_order"    />
    </resultMap>

    <sql id="selectJwTeamVo">
        select id, team_name, user_name, user_phone, addr, create_time, update_time, remark, create_user_id, match_id from jw_team
    </sql>

    <select id="selectJwTeamList" parameterType="JwTeam" resultMap="JwTeamResult">
        select jt.*, jmt.index_order from jw_team jt
        left join jw_match_team jmt on jmt.team_id = jt.id
        <where>
            <if test="teamName != null  and teamName != ''"> and team_name like concat('%', #{teamName}, '%')</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="userPhone != null  and userPhone != ''"> and user_phone = #{userPhone}</if>
            <if test="addr != null  and addr != ''"> and addr = #{addr}</if>
            <if test="createUserId != null "> and create_user_id = #{createUserId}</if>
            <if test="matchId != null "> and jmt.match_id = #{matchId}</if>
            <if test="indexOrder != null "> and jmt.index_order = #{indexOrder}</if>
        </where>
        order by jmt.index_order asc
    </select>

    <select id="selectJwTeamByUserId" parameterType="Long" resultMap="JwTeamResult">
        <include refid="selectJwTeamVo"/>
        where create_user_id = #{createUserId}
    </select>

    <select id="selectJwTeamById" parameterType="Long" resultMap="JwTeamResult">
        <include refid="selectJwTeamVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertJwTeam" parameterType="JwTeam" useGeneratedKeys="true" keyProperty="id">
        insert into jw_team
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="teamName != null">team_name,</if>
            <if test="userName != null">user_name,</if>
            <if test="userPhone != null">user_phone,</if>
            <if test="addr != null">addr,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="createUserId != null">create_user_id,</if>
            <if test="matchId != null">match_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="teamName != null">#{teamName},</if>
            <if test="userName != null">#{userName},</if>
            <if test="userPhone != null">#{userPhone},</if>
            <if test="addr != null">#{addr},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createUserId != null">#{createUserId},</if>
            <if test="matchId != null">#{matchId},</if>
         </trim>
    </insert>

    <update id="updateJwTeam" parameterType="JwTeam">
        update jw_team
        <trim prefix="SET" suffixOverrides=",">
            <if test="teamName != null">team_name = #{teamName},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="userPhone != null">user_phone = #{userPhone},</if>
            <if test="addr != null">addr = #{addr},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createUserId != null">create_user_id = #{createUserId},</if>
            <if test="matchId != null">match_id = #{matchId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteJwTeamById" parameterType="Long">
        delete from jw_team where id = #{id}
    </delete>

    <delete id="deleteJwTeamByIds" parameterType="String">
        delete from jw_team where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>